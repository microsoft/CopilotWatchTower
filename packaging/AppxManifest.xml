<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for CopilotWatchTower.

  Build pipeline (high level):
    1. pyinstaller packaging/copilot-watchtower.spec
    2. Place dist/CopilotWatchTower/* alongside this manifest in a
       staging folder (e.g. build\msix-staging\).
    3. makeappx pack /d build\msix-staging /p CopilotWatchTower.msix
    4. signtool sign /fd SHA256 /a CopilotWatchTower.msix

  The whole pipeline is automated by packaging\build-msix.ps1, which also
  patches the Identity Name / Publisher / Version below from its parameters
  so they match the signing certificate. The Contoso values here are
  placeholders for manual/unsigned local testing only.
-->
<Package
    xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
    xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
    xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
    IgnorableNamespaces="uap rescap">

  <Identity
      Name="Contoso.CopilotWatchTower"
      Publisher="CN=Contoso Tenant Tools"
      Version="0.1.0.0"
      ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>CopilotWatchTower</DisplayName>
    <PublisherDisplayName>Contoso Tenant Tools</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>Microsoft 365 Copilot 상호작용 수집 관리자 도구</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.22631.0" />
  </Dependencies>

  <Resources>
    <Resource Language="ko-KR" />
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App" Executable="CopilotWatchTower.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
          DisplayName="CopilotWatchTower"
          Description="Microsoft 365 Copilot 상호작용 수집"
          Square150x150Logo="Assets\Square150x150Logo.png"
          Square44x44Logo="Assets\Square44x44Logo.png"
          BackgroundColor="transparent">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust is required because we ship an unmodified
         PyInstaller bundle and use Win32 DPAPI / network APIs. -->
    <rescap:Capability Name="runFullTrust" />
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
